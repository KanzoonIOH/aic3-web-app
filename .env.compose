# =============================================================================
# web/.env.compose
# Frontend env for the docker-compose build.
#
# IMPORTANT: Vite inlines VITE_* vars at BUILD time into the static JS bundle.
# It is passed to the image as a --build-arg (see root docker-compose.yml:
# services.web-app.build.args.VITE_API_URL), NOT injected at container runtime.
# This file documents the value; the build arg in compose is what actually
# takes effect.
#
# This is a browser-facing URL, so it must be reachable from the USER'S BROWSER
# (the host), not from inside the docker network. It points at the published
# api-service port (SERVER_PORT).
#
# The EFFECTIVE value comes from VITE_API_URL in the ROOT .env (the build arg).
# This file is reference-only — keep it equal to the root value, or use it for
# `pnpm dev` outside docker.
# =============================================================================

VITE_API_URL=http://localhost:6767/api
